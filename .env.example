# Contact form mail (src/app/api/sendMail/route.ts)
# Copy to .env.local for local development. Never commit real values.

# Google Workspace / Gmail SMTP
SMTP_HOST=smtp.gmail.com

# Must be 465 — the route hardcodes `secure: true`, which needs implicit TLS.
# Port 587 will hang rather than fail with a clear error.
SMTP_PORT=465

# The sending account. `from:` is derived from this so the sender always
# matches the authenticated account and stays SPF-aligned.
SMTP_USER=

# A 16-character Google App Password, NOT the account password.
# Google Account -> Security -> App Passwords (requires 2FA).
SMTP_PASS=

# Where contact form submissions are delivered. This is deliberately NOT the
# address shown on the site (ahmad@getevalonqa.com) — displayed address and
# form recipient are separate on purpose.
# Change here instead of in code; falls back to ahmad.abdullah@evalonqa.com if unset.
CONTACT_TO=ahmad.abdullah@evalonqa.com
